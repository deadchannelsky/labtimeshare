# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=file:./lts.db

# ─── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string

# ─── Server ─────────────────────────────────────────────────────────────────────
SERVER_IP=192.168.1.100
PORT=3000

# ─── vLLM Integration ───────────────────────────────────────────────────────────
VLLM_KEYS_FILE=/path/to/vllm/permitted_keys.txt

# ─── Background Jobs ────────────────────────────────────────────────────────────
# Expiry check: how often to check for access grants past their expiresAt time (minutes)
EXPIRY_CHECK_INTERVAL_MINUTES=5

# Cleanup check: how often to check for revoked accounts ready for deletion (minutes)
# Set to 0 to disable auto-cleanup; accounts can still be manually deleted via admin panel
CLEANUP_CHECK_INTERVAL_MINUTES=60

# ─── Account Cleanup & Retention Policy ──────────────────────────────────────
# When approvers approve shell access requests, they can optionally set an auto-delete policy.
# Example values: null (manual only), 0 (delete immediately on revocation), 7 (delete after 7 days), 30, 90, etc.
# Default behavior: manual only (no auto-deletion unless explicitly set per-grant)

# ─── UI ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=LabTimeShare
